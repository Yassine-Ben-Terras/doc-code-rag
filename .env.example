POSTGRES_PASSWORD=replace-with-a-long-random-password
API_DB_PASSWORD=replace-with-a-different-random-password
WORKER_DB_PASSWORD=replace-with-another-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.internal
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Generated by scripts/configure.py. Back up with the DB; do not rotate casually.
LLM_ENCRYPTION_KEY=replace-with-generated-fernet-key
RERANK_THRESHOLD=0.5
CONTEXT_PREFIX=true
# Change if another project already uses port 8000.
API_PORT=8000
# CPU-friendly document indexing; API question timeout remains separate.
EMBEDDING_BATCH_SIZE=4
EMBEDDING_TIMEOUT=900
RERANK_TIMEOUT=600
CHAT_REQUEST_TIMEOUT=1020
# Limit local model CPU parallelism and memory used per inference batch.
INFERENCE_CPU_THREADS=2
INFERENCE_BATCH_SIZE=2
# Optional, read-only token for an explicitly connected private GitHub repository
GITHUB_TOKEN=
